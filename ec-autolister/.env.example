# ===== 全般 =====
# true の間は出品APIを呼ばず、送信内容を data/output/<sku>/{rakuten,yahoo}/requests/ に保存するだけ
DRY_RUN=true
MARKETPLACES=rakuten,yahoo
AUTOLISTER_DATA_DIR=./data

# ===== Claude (商品名・説明文の生成) =====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ===== リサーチ (競合価格の検索) =====
# 楽天ウェブサービスのアプリID (https://webservice.rakuten.co.jp/)
RAKUTEN_APP_ID=
# 新しいAPIドメインでアクセスキーが必要な場合のみ設定し、RAKUTEN_SEARCH_URL も合わせて変更
RAKUTEN_ACCESS_KEY=
# Yahoo!デベロッパーネットワークの Client ID (アプリケーションID)
YAHOO_APP_ID=
# 競合から除外する語 (中古品など)
EXCLUDE_WORDS=中古,USED,ユーズド,訳あり,ジャンク

# ===== 価格・利益 =====
# 販売価格に対する手数料合計の目安 (システム利用料・決済手数料・ポイント原資・アフィリエイト等)
RAKUTEN_FEE_RATE=0.12
YAHOO_FEE_RATE=0.10
# 送料 (CSV で shipping_jpy 未指定時)。販売価格は送料込みで計算
DEFAULT_SHIPPING_JPY=1000
# 最低利益 (率は仕入原価に対する利益率 = POIZON Calc と同じ定義)
MIN_PROFIT_RATE=0.10
MIN_PROFIT_JPY=1000
# 競合最安値から何円下げるか
UNDERCUT_JPY=10
# 競合なしの場合の価格 = 最低価格 × この倍率
NO_COMPETITOR_MARKUP=1.15
# 最低利益を確保すると最安値よりこの割合以上高くなる商品は D (見送り)
MAX_GAP_RATE=0.05
# このランク以上は自動承認 (空なら全て手動承認)。例: A
AUTO_APPROVE_GRADE=

# ===== 画像 =====
# 日本語フォント (未指定なら Noto/IPA/ヒラギノ/メイリオを自動検出)
FONT_PATH=
IMAGE_SIZE=1200

# ===== 楽天 RMS API =====
RAKUTEN_SERVICE_SECRET=
RAKUTEN_LICENSE_KEY=
# 店舗URL (https://www.rakuten.co.jp/<ここ>/)
RAKUTEN_SHOP_URL=
# 画像を入れる R-Cabinet フォルダ (0 = 基本フォルダ) とそのパス
RAKUTEN_CABINET_FOLDER_ID=0
RAKUTEN_CABINET_FOLDER_PATH=
# 既定のジャンルID (CSV の rakuten_genre_id が優先)
RAKUTEN_GENRE_ID=
# true = 倉庫に入れた状態で登録 (RMS で確認してから公開)
RAKUTEN_HIDE_ITEM=true

# ===== Yahoo! ストアAPI =====
YAHOO_SELLER_ID=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=oob
# `autolister yahoo-auth` で取得したトークンは DB に保存される。ここは初期値として使う場合のみ
YAHOO_REFRESH_TOKEN=
# ストアクリエイターPro で発行した公開鍵 (公開鍵認証) とそのバージョン
YAHOO_PUBLIC_KEY_PATH=
YAHOO_PUBLIC_KEY_VERSION=
# 検証環境を使う場合: https://test.circus.shopping.yahooapis.jp/ShoppingWebService/V1
YAHOO_STORE_API_BASE=https://circus.shopping.yahooapis.jp/ShoppingWebService/V1
# ストアカテゴリのパス、既定のプロダクトカテゴリID
YAHOO_STORE_PATH=
YAHOO_PRODUCT_CATEGORY=
# false = 非公開で登録
YAHOO_DISPLAY=false

# ===== 商品ページ共通 =====
# 「ご注意」に載せる文言 (| 区切り)
SHOP_NOTES=モニターの発色により実物と色味が異なる場合がございます。|お客様都合による返品・交換はお受けできません。
